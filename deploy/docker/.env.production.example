# Copy this file outside the repository or to deploy/docker/.env.production (ignored), then fill every value.
# Pin to a digest in production, for example: docker.cnb.cool/dextercai/docker/dba_mcp@sha256:...
DBA_MCP_IMAGE=docker.cnb.cool/dextercai/docker/dba_mcp@sha256:REPLACE_WITH_RELEASE_DIGEST
DBA_MCP_BIND_ADDRESS=127.0.0.1
DBA_MCP_HOST_PORT=8080
DBA_MCP_MEMORY_LIMIT=768m
DBA_MCP_CPU_LIMIT=1.0
# Absolute host root for all container bind mounts. Required layout:
# config/ (non-secret Spring configuration), assets/dba-mcp-assets.db,
# known-hosts/known_hosts, and audit/. Config and known-hosts are mounted read-only;
# assets/ is writable so the authenticated asset administration API can manage inventory.
DBA_MCP_HOST_BASE_DIR=/srv/dba-mcp
DBA_MCP_API_TOKEN=REPLACE_WITH_SECRET
DBA_MCP_ALLOWED_ORIGINS=https://mcp.example.internal
DBA_ASSET_ADMIN_USERNAME=REPLACE_WITH_SECRET
# BCrypt hash, not a plaintext password.
DBA_ASSET_ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
